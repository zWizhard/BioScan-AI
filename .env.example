# HuggingFace
HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxx

# App
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/bioscan.db

# Bayesian Engine
GBIF_SEARCH_RADIUS_KM=50
GBIF_MAX_OCCURRENCES=300
PRIOR_SMOOTHING_ALPHA=1         # Laplace smoothing
MIN_MODEL_CONFIDENCE=0.05       # descartar candidatas abaixo disso

# Cache
GBIF_CACHE_TTL_HOURS=168        # 7 dias
